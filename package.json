{
  "name": "playwright-typescript-framework",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "login": "playwright test tests/LoginTest.spec.ts",
    "chrome": "playwright test --project=chrome",
    "edge": "playwright test --project=edge",
    "headed": "playwright test --headed",
    "allure:clean": "rimraf allure-results allure-report",
    "allure:run": "npm run allure:clean && npm run test",
    "allure:open": "allure serve allure-results",
    "allure:generate": "allure generate allure-results --clean -o allure-report"
    
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.8.0",
    "allure-commandline": "^2.41.0",
    "allure-playwright": "^3.8.0",
    "rimraf": "^6.1.3"
  },
  "dependencies": {
    "winston": "^3.19.0"
  }
}
